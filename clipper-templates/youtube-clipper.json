{
	"schemaVersion": "0.1.0",
	"name": "Youtube",
	"behavior": "create",
	"noteContentFormat": "{{content}}",
	"properties": [
		{
			"name": "categories",
			"value": "[[Videos]]",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{published}}",
			"type": "date"
		},
		{
			"name": "author",
			"value": "{{selector:#text > a}}",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://www.youtube.com/"
	],
	"noteNameFormat": "{{title}}",
	"path": "Clippings"
}